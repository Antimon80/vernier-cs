<Window x:Class="Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ui"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="700"
        Width="1200"
        MinHeight="700"
        MinWidth="1200"
        Background="#F2F2F2">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarImageStyle" TargetType="Image">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top"
                Height="52"
                Background="#F2F2F2"
                Padding="8,4,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Open" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/open.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Save" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/save.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Save As" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/save_as.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Print" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/print.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Import" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/import.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Export" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/export.png" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Undo" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/undo.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Redo" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/redo.png" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Operating Mode" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/operating_mode.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Acquisition Mode" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/acquisition_mode.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Calibrate" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/calibrate.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Start" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/start.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Stop" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/stop.png" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Crosshair" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/crosshair.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Analyze" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/analyze.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Annotations" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/annotations.png" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="8"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Settings" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/settings.png" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Help" Click="Button_Click">
                        <Image Style="{StaticResource ToolbarImageStyle}" Source="/Ui;component/Assets/help.png" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,40,0,0"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Background="White"
                    Height="780"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="102" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="106" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="0,0,1,1"
                                Background="Transparent" />

                        <Border Grid.Column="1"
                                BorderBrush="Black"
                                BorderThickness="0,0,1,1"
                                Background="Transparent">
                            <TextBlock Style="{StaticResource TableHeaderTextStyle}"
                                       Text="λ&#x0a;[nm]" />
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="Black"
                                BorderThickness="0,0,0,1"
                                Background="Transparent">
                            <TextBlock Style="{StaticResource TableHeaderTextStyle}"
                                       Text="ADC&#x0a;[counts]" />
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              HeadersVisibility="None"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single"
                              GridLinesVisibility="All"
                              BorderThickness="0"
                              RowHeaderWidth="60"
                              FontSize="14"
                              Background="White"
                              AlternatingRowBackground="White"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="106"
                                                Binding="{Binding LambdaNm}" />
                            <DataGridTextColumn Width="120"
                                                Binding="{Binding AdcCounts}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="106" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="0,1,1,0"
                                Background="Transparent" />

                        <Border Grid.Column="1"
                                BorderBrush="Black"
                                BorderThickness="0,1,1,0"
                                Background="Transparent" />

                        <Border Grid.Column="2"
                                BorderBrush="Black"
                                BorderThickness="0,1,0,0"
                                Background="Transparent" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2"
                  Margin="0,100,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Background="Transparent"
                        Margin="180,0,0,0" />

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ADC counts [counts]"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="1"
                        Margin="320,0,220,0"
                        Height="20"
                        VerticalAlignment="Center"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <Grid>
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#A000D8" Offset="0.00" />
                                    <GradientStop Color="#2500FF" Offset="0.12" />
                                    <GradientStop Color="#00D8FF" Offset="0.22" />
                                    <GradientStop Color="#00FF00" Offset="0.36" />
                                    <GradientStop Color="#E6FF00" Offset="0.52" />
                                    <GradientStop Color="#FFA000" Offset="0.66" />
                                    <GradientStop Color="#FF4A00" Offset="0.82" />
                                    <GradientStop Color="#FF0000" Offset="1.00" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Margin="180,0,0,0">
                    <TextBlock Text="Wellenlänge [nm]"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,10,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
