<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="App.Views.MeasurementPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:App.Resources.Strings"
             Title="{Binding PageTitle}"
             BackgroundColor="White">
  <Grid RowDefinitions="Auto,*"
        Padding="8"
        RowSpacing="8">
    <!-- Generic toolbar -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,30,Auto,Auto,30,Auto,Auto,Auto,30,Auto,Auto,30,Auto,Auto,30,*,Auto,Auto,Auto,Auto"
          ColumnSpacing="8"
          VerticalOptions="Center">
      <ImageButton Grid.Column="0"
                   Source="open.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenFileCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_OpenFile}"/>
      <ImageButton Grid.Column="1"
                   Source="save.png"
                   BackgroundColor="Transparent"
                   Command="{Binding SaveFileCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_SaveFile}"/>
      <ImageButton Grid.Column="2"
                   Source="save_as.png"
                   BackgroundColor="Transparent"
                   Command="{Binding SaveFileAsCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_SaveFileAs}"/>
      <ImageButton Grid.Column="3"
                   Source="import.png"
                   Rotation="90"
                   BackgroundColor="Transparent"
                   Command="{Binding ImportDataCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_ImportData}"/>
      <ImageButton Grid.Column="4"
                   Source="export.png"
                   Rotation="270"
                   BackgroundColor="Transparent"
                   Command="{Binding ExportDataCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_ExportData}"/>
      <ImageButton Grid.Column="6"
                   Source="operating_mode.png"
                   BackgroundColor="Transparent"
                   IsVisible="{Binding HasOperatingModeSelection}"
                   Command="{Binding OpenOperatingModeCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.Spectrometer_OperatingMode}"/>
      <ImageButton Grid.Column="7"
                   Source="acquisition_mode.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenAcquisitionModeCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.Device_AcquisitionMode}"/>
      <ImageButton Grid.Column="9"
                   Source="calibrate.png"
                   BackgroundColor="Transparent"
                   IsEnabled="{Binding IsCalibrationEnabled}"
                   Command="{Binding CalibrateCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.Device_Calibrate}"/>
      <ImageButton Grid.Column="10"
                   Source="{Binding RecordingIcon}"
                   BackgroundColor="Transparent"
                   Command="{Binding ToggleMeasurementCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.Device_ToggleMeasurement}"/>
      <ImageButton Grid.Column="11"
                   Source="keep_datapoint.png"
                   BackgroundColor="Transparent"
                   IsVisible="{Binding HasKeepDataPointCommand}"
                   Command="{Binding KeepDataPointCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.Device_KeepDataPoint}"/>
      <ImageButton Grid.Column="13"
                   Source="autoscale.png"
                   BackgroundColor="Transparent"
                   Command="{Binding AutoscaleCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_Autoscale}"/>
      <ImageButton Grid.Column="14"
                   Source="crosshairs.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenCursorCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_CrossHairs}"/>
      <ImageButton Grid.Column="16"
                   Source="data.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenDataManagerCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_DataManagement}"/>
      <ImageButton Grid.Column="17"
                   Source="analyze.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenAnalysisCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_DataAnalysis}"/>
      <ImageButton Grid.Column="20"
                   Source="diagnostics.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenDiagnosticsCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.Device_Diagnostics}"/>
      <ImageButton Grid.Column="21"
                   Source="settings.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenSettingsCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_Settings}"/>
      <ImageButton Grid.Column="22"
                   Source="help.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenHelpCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_Help}"/>
      <ImageButton Grid.Column="23"
                   Source="about.png"
                   BackgroundColor="Transparent"
                   Command="{Binding OpenAboutCommand}"
                   ToolTipProperties.Text="{x:Static strings:AppResources.App_About}"/>
    </Grid>
    <!-- Device-specific measurement content -->
    <ContentView x:Name="DeviceContentHost"
                 Grid.Row="1"/>
  </Grid>
</ContentPage>