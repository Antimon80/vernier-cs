<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="App.Views.GoDirect.SpectroVisKeepDataPointDialog"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:App.Resources.Strings"
             BackgroundColor="#80000000">
       <Grid>
              <ScrollView>
              <Border WidthRequest="360"
                      Padding="22"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                      Stroke="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                      StrokeThickness="1">
                     <VerticalStackLayout Spacing="16">
                            <Label Text="{x:Static res:AppResources.Device_KeepDataPoint}"
                                   FontAttributes="Bold"
                                   FontSize="Large"/>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>

                            <Grid ColumnDefinitions="Auto,90,Auto"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center">
                                   <Label Grid.Column="0"
                                          Text="{Binding ColumnNameShort}"
                                          VerticalOptions="Center"/>
                                   <Entry Grid.Column="1"
                                          Text="{Binding DataPointValue,Mode=TwoWay}"
                                          Keyboard="Numeric"
                                          HorizontalTextAlignment="End"/>
                                   <Label Grid.Column="2"
                                          Text="{Binding Unit}"
                                          VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10">
                                   <Button Grid.Column="1"
                                           Text="{x:Static res:AppResources.Dialog_Cancel}"
                                           Clicked="CancelClicked"/>
                                   <Button Grid.Column="2"
                                           Text="{x:Static res:AppResources.Dialog_Ok}"
                                           Clicked="OkClicked"/>
                            </Grid>
                     </VerticalStackLayout>
              </Border>
              </ScrollView>
       </Grid>
</ContentPage>
