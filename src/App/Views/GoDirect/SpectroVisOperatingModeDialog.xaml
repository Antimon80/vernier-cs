<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="App.Views.GoDirect.SpectroVisOperatingModeDialog"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:App.Resources.Strings"
             BackgroundColor="#80000000">
       <Grid>
              <Border WidthRequest="560"
                      Padding="22"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                      Stroke="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                      StrokeThickness="1">
                     <VerticalStackLayout Spacing="16">
                            <Label Text="{x:Static res:AppResources.OperatingMode_DialogTitle}"
                                   FontAttributes="Bold"
                                   FontSize="Large"/>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                            <Grid ColumnDefinitions="130,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="16"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.Column="0"
                                          Text="{x:Static res:AppResources.OperatingMode_DeviceType}"
                                          FontAttributes="Bold"/>
                                   <Label Grid.Row="0"
                                          Grid.Column="1"
                                          Text="{Binding SpectrometerType}"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="0"
                                          Text="{x:Static res:AppResources.OperatingMode_MeasurementRange}"
                                          FontAttributes="Bold"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="1"
                                          Text="{Binding MeasurementRangeText}"/>
                            </Grid>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                            <Grid RadioButtonGroup.GroupName="SpectroVisOperatingModes"
                                  ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="36"
                                  RowSpacing="12">
                                   <RadioButton Grid.Row="0"
                                                Grid.Column="0"
                                                Content="{Binding OperatingModeOptions[3].DisplayName}"
                                                IsEnabled="{Binding OperatingModeOptions[3].IsSupported}"
                                                IsChecked="{Binding OperatingModeOptions[3].IsSelected,Mode=TwoWay}"/>
                                   <RadioButton Grid.Row="1"
                                                Grid.Column="0"
                                                Content="{Binding OperatingModeOptions[2].DisplayName}"
                                                IsEnabled="{Binding OperatingModeOptions[2].IsSupported}"
                                                IsChecked="{Binding OperatingModeOptions[2].IsSelected,Mode=TwoWay}"/>
                                   <RadioButton Grid.Row="2"
                                                Grid.Column="0"
                                                Content="{Binding OperatingModeOptions[1].DisplayName}"
                                                IsEnabled="{Binding OperatingModeOptions[1].IsSupported}"
                                                IsChecked="{Binding OperatingModeOptions[1].IsSelected,Mode=TwoWay}"/>
                                   <RadioButton Grid.Row="0"
                                                Grid.Column="1"
                                                Content="{Binding OperatingModeOptions[4].DisplayName}"
                                                IsEnabled="{Binding OperatingModeOptions[4].IsSupported}"
                                                IsChecked="{Binding OperatingModeOptions[4].IsSelected,Mode=TwoWay}"/>
                                   <RadioButton Grid.Row="1"
                                                Grid.Column="1"
                                                Content="{Binding OperatingModeOptions[5].DisplayName}"
                                                IsEnabled="{Binding OperatingModeOptions[5].IsSupported}"
                                                IsChecked="{Binding OperatingModeOptions[5].IsSelected,Mode=TwoWay}"/>
                                   <RadioButton Grid.Row="2"
                                                Grid.Column="1"
                                                Content="{Binding OperatingModeOptions[0].DisplayName}"
                                                IsEnabled="{Binding OperatingModeOptions[0].IsSupported}"
                                                IsChecked="{Binding OperatingModeOptions[0].IsSelected,Mode=TwoWay}"/>
                            </Grid>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                            <Grid ColumnDefinitions="Auto,90,Auto"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center">
                                   <Label Grid.Column="0"
                                          Text="{x:Static res:AppResources.OperatingMode_IntegrationTime}"
                                          VerticalOptions="Center"/>
                                   <Entry Grid.Column="1"
                                          Text="{Binding IntegrationTimeMs, Mode=TwoWay}"
                                          Keyboard="Numeric"
                                          HorizontalTextAlignment="End"
                                          IsEnabled="{Binding CanEditIntegrationTime}"/>
                                   <Label Grid.Column="2"
                                          Text="ms"
                                          VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="10">
                                   <ImageButton Grid.Column="0"
                                                Source="help.png"
                                                BackgroundColor="Transparent"
                                                Command="{Binding OpenHelpCommand}"
                                                ToolTipProperties.Text="{x:Static res:AppResources.App_Help}"/>
                                   <Button Grid.Column="2"
                                           Text="{x:Static res:AppResources.Dialog_Cancel}"
                                           Clicked="CancelClicked"/>
                                   <Button Grid.Column="3"
                                           Text="{x:Static res:AppResources.Dialog_Ok}"
                                           Clicked="OkClicked"/>
                            </Grid>
                     </VerticalStackLayout>
              </Border>
       </Grid>
</ContentPage>