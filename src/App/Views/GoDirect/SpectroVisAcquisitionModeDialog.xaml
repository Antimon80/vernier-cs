<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="App.Views.GoDirect.SpectroVisAcquisitionModeDialog"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:App.Resources.Strings"
             BackgroundColor="#80000000">
       <Grid>
              <ScrollView>
              <Border WidthRequest="760"
                      Padding="22"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                      Stroke="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                      StrokeThickness="1">
                     <VerticalStackLayout Spacing="16">
                            <Label Text="{x:Static res:AppResources.AcquisitionMode_DialogTitle}"
                                   FontAttributes="Bold"
                                   FontSize="Large"/>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                            <Grid ColumnDefinitions="130,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="16"
                                  RowSpacing="8">
                                   <Label Grid.Row="0"
                                          Grid.Column="0"
                                          Text="{x:Static res:AppResources.OperatingMode_DeviceType}"
                                          FontAttributes="Bold"/>
                                   <Label Grid.Row="0"
                                          Grid.Column="1"
                                          Text="{Binding SpectrometerType}"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="0"
                                          Text="{x:Static res:AppResources.OperatingMode_MeasurementRange}"
                                          FontAttributes="Bold"/>
                                   <Label Grid.Row="1"
                                          Grid.Column="1"
                                          Text="{Binding MeasurementRangeText}"/>
                            </Grid>
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>

                            <!-- Body: mode selection and mode-specific settings on the left, spectrum preview and wavelength on the right -->
                            <Grid ColumnDefinitions="*,24,*"
                                  ColumnSpacing="0">

                                   <!-- Left column -->
                                   <VerticalStackLayout Grid.Column="0"
                                                        Spacing="16">
                                          <Grid RadioButtonGroup.GroupName="SpectroVisAcquisitionModes"
                                                RowDefinitions="Auto,Auto,Auto"
                                                RowSpacing="12">
                                                 <RadioButton Grid.Row="0"
                                                              Content="{Binding AcquisitionModeOptions[0].DisplayName}"
                                                              IsChecked="{Binding AcquisitionModeOptions[0].IsSelected,Mode=TwoWay}"/>
                                                 <RadioButton Grid.Row="1"
                                                              Content="{Binding AcquisitionModeOptions[1].DisplayName}"
                                                              IsChecked="{Binding AcquisitionModeOptions[1].IsSelected,Mode=TwoWay}"/>
                                                 <RadioButton Grid.Row="2"
                                                              Content="{Binding AcquisitionModeOptions[2].DisplayName}"
                                                              IsChecked="{Binding AcquisitionModeOptions[2].IsSelected,Mode=TwoWay}"/>
                                          </Grid>

                                          <BoxView HeightRequest="1"
                                                   BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>

                                          <Grid ColumnDefinitions="Auto,90,Auto"
                                                ColumnSpacing="8"
                                                VerticalOptions="Center">
                                                 <Label Grid.Column="0"
                                                        Text="{x:Static res:AppResources.AcquisitionMode_Duration}"
                                                        VerticalOptions="Center"/>
                                                 <Entry Grid.Column="1"
                                                        Text="{Binding TimeResolvedDuration,Mode=TwoWay}"
                                                        Keyboard="Numeric"
                                                        HorizontalTextAlignment="End"
                                                        IsEnabled="{Binding CanEditDuration}"/>
                                                 <Label Grid.Column="2"
                                                        Text="s"
                                                        VerticalOptions="Center"/>
                                          </Grid>

                                          <HorizontalStackLayout Spacing="8">
                                                 <CheckBox IsChecked="{Binding ContinuousDataCollection,Mode=TwoWay}"
                                                           IsEnabled="{Binding CanEditTimeResolvedSettings}"/>
                                                 <Label Text="{x:Static res:AppResources.AcquisitionMode_ContinuousCollection}"
                                                        VerticalOptions="Center"/>
                                          </HorizontalStackLayout>

                                          <BoxView HeightRequest="1"
                                                   BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>

                                          <Grid ColumnDefinitions="130,*"
                                                RowDefinitions="Auto,Auto,Auto,Auto"
                                                ColumnSpacing="16"
                                                RowSpacing="8">
                                                 <Label Grid.Row="0"
                                                        Grid.Column="0"
                                                        Text="{x:Static res:AppResources.AcquisitionMode_ColumnNameLong}"
                                                        VerticalOptions="Center"/>
                                                 <Entry Grid.Row="0"
                                                        Grid.Column="1"
                                                        Text="{Binding ColumnNameLong,Mode=TwoWay}"
                                                        MaxLength="40"
                                                        IsEnabled="{Binding CanEditEventTriggeredSettings}"/>
                                                 <Label Grid.Row="1"
                                                        Grid.Column="0"
                                                        Text="{x:Static res:AppResources.AcquisitionMode_ColumnNameShort}"
                                                        VerticalOptions="Center"/>
                                                 <Entry Grid.Row="1"
                                                        Grid.Column="1"
                                                        Text="{Binding ColumnNameShort,Mode=TwoWay}"
                                                        MaxLength="8"
                                                        IsEnabled="{Binding CanEditEventTriggeredSettings}"/>
                                                 <Label Grid.Row="2"
                                                        Grid.Column="0"
                                                        Text="{x:Static res:AppResources.AcquisitionMode_Unit}"
                                                        VerticalOptions="Center"/>
                                                 <Picker Grid.Row="2"
                                                         Grid.Column="1"
                                                         ItemsSource="{Binding UnitOptions}"
                                                         SelectedItem="{Binding SelectedUnit,Mode=TwoWay}"
                                                         IsEnabled="{Binding CanEditEventTriggeredSettings}"/>
                                                 <Entry Grid.Row="3"
                                                        Grid.Column="1"
                                                        Text="{Binding CustomUnit,Mode=TwoWay}"
                                                        MaxLength="10"
                                                        IsVisible="{Binding IsCustomUnitSelected}"
                                                        IsEnabled="{Binding CanEditEventTriggeredSettings}"/>
                                          </Grid>
                                   </VerticalStackLayout>

                                   <!-- Right column: live spectrum preview and sampled wavelength -->
                                   <VerticalStackLayout Grid.Column="2"
                                                        Spacing="16">
                                          <Border Stroke="Black"
                                                  StrokeThickness="1"
                                                  BackgroundColor="White"
                                                  HeightRequest="220">
                                                 <Label Text="Diagramm"
                                                        TextColor="Gray"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                          </Border>

                                          <Grid ColumnDefinitions="Auto,90,Auto"
                                                ColumnSpacing="8"
                                                VerticalOptions="Center">
                                                 <Label Grid.Column="0"
                                                        Text="{x:Static res:AppResources.AcquisitionMode_Wavelength}"
                                                        VerticalOptions="Center"/>
                                                 <Entry Grid.Column="1"
                                                        Text="{Binding SelectedWavelength,Mode=TwoWay}"
                                                        Keyboard="Numeric"
                                                        HorizontalTextAlignment="End"
                                                        IsEnabled="{Binding CanEditWavelength}"/>
                                                 <Label Grid.Column="2"
                                                        Text="nm"
                                                        VerticalOptions="Center"/>
                                          </Grid>
                                   </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="10">
                                   <ImageButton Grid.Column="0"
                                                Source="help.png"
                                                BackgroundColor="Transparent"
                                                Command="{Binding OpenHelpCommand}"
                                                ToolTipProperties.Text="{x:Static res:AppResources.App_Help}"/>
                                   <Button Grid.Column="2"
                                           Text="{x:Static res:AppResources.Dialog_Cancel}"
                                           Clicked="CancelClicked"/>
                                   <Button Grid.Column="3"
                                           Text="{x:Static res:AppResources.Dialog_Ok}"
                                           Clicked="OkClicked"/>
                            </Grid>
                     </VerticalStackLayout>
              </Border>
              </ScrollView>
       </Grid>
</ContentPage>
