<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="App.Views.GoDirect.SpectroVisMeasurementView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:App.Resources.Strings"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:App.Views.Controls"
             BackgroundColor="Transparent">
    <Grid RowDefinitions="*,Auto"
          Padding="8"
          RowSpacing="8">
        <!-- Chart area (table is generic and lives in MeasurementPage) -->
        <Border Grid.Row="0"
                Stroke="Black"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="8">
            <Grid RowDefinitions="Auto,*">
                <Label Grid.Row="0"
                       Text="{Binding Chart.ChartTitle}"
                       FontAttributes="Bold"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,*"
                      Padding="4">
                    <Label Grid.Column="0"
                           Text="{Binding Chart.YAxisTitle}"
                           Rotation="-90"
                           FontAttributes="Bold"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Grid Grid.Column="1"
                          RowDefinitions="*,Auto,Auto">
                        <controls:MeasurementChart x:Name="Chart"
                                                   Grid.Row="0"
                                                   XMinimum="{Binding Chart.XMinimum, Mode=TwoWay}"
                                                   XMaximum="{Binding Chart.XMaximum, Mode=TwoWay}"
                                                   YMinimum="{Binding Chart.YMinimum, Mode=TwoWay}"
                                                   YMaximum="{Binding Chart.YMaximum, Mode=TwoWay}"
                                                   XAxisLowerLimit="{Binding Chart.XAxisLowerLimit}"
                                                   XAxisUpperLimit="{Binding Chart.XAxisUpperLimit}"
                                                   YAxisLowerLimit="{Binding Chart.YAxisLowerLimit}"
                                                   YAxisUpperLimit="{Binding Chart.YAxisUpperLimit}"
                                                   XValues="{Binding Chart.XValues}"
                                                   YValues="{Binding Chart.YValues}"/>
                        <controls:SpectrumStripView Grid.Row="1"
                                                    HeightRequest="18"
                                                    Margin="0,4,0,0"
                                                    IsVisible="{Binding ShowSpectrumStrip}"
                                                    XMinimum="{Binding Chart.XMinimum}"
                                                    XMaximum="{Binding Chart.XMaximum}"
                                                    PlotLeftFraction="{Binding Source={x:Reference Chart}, Path=PlotLeftFraction}"
                                                    PlotRightFraction="{Binding Source={x:Reference Chart}, Path=PlotRightFraction}"/>
                        <Label Grid.Row="2"
                               Text="{Binding Chart.XAxisTitle}"
                               FontAttributes="Bold"
                               FontSize="18"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <!-- Status bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,Auto,40,Auto,Auto,40,Auto,Auto,40,Auto,Auto,*"
              ColumnSpacing="10"
              Padding="8,4">
            <Label Grid.Column="0"
                   Text="{x:Static strings:AppResources.Device_IsInitialized}"
                   FontSize="18"
                   VerticalOptions="Center"/>
            <shapes:Ellipse Grid.Column="1"
                            WidthRequest="24"
                            HeightRequest="24"
                            Fill="{Binding InitializationStatusColor}"
                            Stroke="Black"
                            StrokeThickness="1"
                            VerticalOptions="Center"/>
            <Label Grid.Column="3"
                   Text="{x:Static strings:AppResources.Spectrometer_WhiteLamp}"
                   FontSize="18"
                   VerticalOptions="Center"/>
            <shapes:Ellipse Grid.Column="4"
                            WidthRequest="24"
                            HeightRequest="24"
                            Fill="{Binding WhiteLampStatusColor}"
                            Stroke="Black"
                            StrokeThickness="1"
                            VerticalOptions="Center"/>
            <Label Grid.Column="6"
                   Text="{x:Static strings:AppResources.Spectrometer_IsCalibrated}"
                   FontSize="18"
                   VerticalOptions="Center"/>
            <shapes:Ellipse Grid.Column="7"
                            WidthRequest="24"
                            HeightRequest="24"
                            Fill="{Binding CalibrationStatusColor}"
                            Stroke="Black"
                            StrokeThickness="1"
                            VerticalOptions="Center"/>
            <Label Grid.Column="9"
                   Text="{x:Static strings:AppResources.Spectrometer_CurrentOperatingMode}"
                   FontSize="18"
                   VerticalOptions="Center"/>
            <Label Grid.Column="10"
                   Text="{Binding CurrentOperatingMode}"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentView>