<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="App.Views.GoDirect.SpectroVisCalibrationDialog"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:App.Resources.Strings"
             BackgroundColor="#80000000">
       <Grid>
              <ScrollView>
                     <Border WidthRequest="560"
                             Padding="22"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                             Stroke="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                             StrokeThickness="1">
                            <VerticalStackLayout Spacing="16">
                                   <Label Text="{x:Static res:AppResources.CalibrationDialog_DialogTitle}"
                                          FontAttributes="Bold"
                                          FontSize="Large"/>
                                   <BoxView HeightRequest="1"
                                            BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                                   <Grid ColumnDefinitions="130,*"
                                         RowDefinitions="Auto,Auto"
                                         ColumnSpacing="16"
                                         RowSpacing="8">
                                          <Label Grid.Row="0"
                                                 Grid.Column="0"
                                                 Text="{x:Static res:AppResources.Device_DeviceType}"
                                                 FontAttributes="Bold"/>
                                          <Label Grid.Row="0"
                                                 Grid.Column="1"
                                                 Text="{Binding SpectrometerType}"/>
                                          <Label Grid.Row="1"
                                                 Grid.Column="0"
                                                 Text="{x:Static res:AppResources.Device_MeasurementRange}"
                                                 FontAttributes="Bold"/>
                                          <Label Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding MeasurementRangeText}"/>
                                   </Grid>
                                   <BoxView HeightRequest="1"
                                            BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                                   <Grid ColumnDefinitions="Auto,*,Auto"
                                         ColumnSpacing="8"
                                         VerticalOptions="Center">
                                          <Label Grid.Column="0"
                                                 Text="{Binding WarmupRemainingSeconds}"
                                                 VerticalOptions="Center"/>
                                          <Label Grid.Column="1"
                                                 Text="{x:Static res:AppResources.Spectrometer_WarmupTimeElapsed}"
                                                 LineBreakMode="WordWrap"
                                                 VerticalOptions="Center"/>
                                          <Button Grid.Column="2"
                                                  Text="{x:Static res:AppResources.CalibrationDialog_SkipWarmup}"
                                                  IsEnabled="{Binding CanSkipWarmup}"
                                                  Clicked="SkipWarmupClicked"
                                                  VerticalOptions="Center"/>
                                   </Grid>
                                   <Grid ColumnDefinitions="*,Auto"
                                         ColumnSpacing="16"
                                         VerticalOptions="Center">
                                          <Label Grid.Column="0"
                                                 Text="{x:Static res:AppResources.Spectrometer_InsertBlank}"
                                                 LineBreakMode="WordWrap"
                                                 VerticalOptions="Center"/>
                                          <Button Grid.Column="1"
                                                  Text="{x:Static res:AppResources.CalibrationDialog_FinishCalibration}"
                                                  Command="{Binding FinishCalibrationCommand}"
                                                  VerticalOptions="Center"/>
                                   </Grid>
                                   <BoxView HeightRequest="1"
                                            BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>
                                   <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                         ColumnSpacing="10">
                                          <ImageButton Grid.Column="0"
                                                       Source="help.png"
                                                       BackgroundColor="Transparent"
                                                       Command="{Binding OpenHelpCommand}"
                                                       ToolTipProperties.Text="{x:Static res:AppResources.App_Help}"/>
                                          <Button Grid.Column="2"
                                                  Text="{x:Static res:AppResources.Dialog_Cancel}"
                                                  Clicked="CancelClicked"/>
                                          <Button Grid.Column="3"
                                                  Text="{x:Static res:AppResources.Dialog_Ok}"
                                                  IsEnabled="{Binding IsCalibrationComplete}"
                                                  Clicked="OkClicked"/>
                                   </Grid>
                            </VerticalStackLayout>

                     </Border>
              </ScrollView>
       </Grid>

</ContentPage>

