<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="App.Views.DiagnosticsDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:App.Resources.Strings"
    BackgroundColor="#80000000">

    <Grid>
        <Border
            WidthRequest="760"
            HeightRequest="560"
            Padding="22"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            Stroke="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
            StrokeThickness="1">

            <Grid
                RowDefinitions="Auto,Auto,*,Auto,Auto"
                RowSpacing="16">

                <Label
                    Grid.Row="0"
                    Text="{x:Static res:AppResources.Diagnostics_DialogTitle}"
                    FontAttributes="Bold"
                    FontSize="Large"/>

                <BoxView
                    Grid.Row="1"
                    HeightRequest="1"
                    BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding}"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Label
                            Text="{x:Static res:AppResources.Diagnostics_NoEntries}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="Gray"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,10"
                                Padding="12"
                                Stroke="{AppThemeBinding Light=#C0C0C0, Dark=#505050}"
                                StrokeThickness="1">

                                <Grid
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="12"
                                    RowSpacing="6">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{Binding Severity}"
                                        FontAttributes="Bold"/>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding Category}"
                                        FontAttributes="Bold"/>

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding Code}"
                                        FontSize="12"
                                        TextColor="Gray"
                                        LineBreakMode="WordWrap"/>

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Message}"
                                        LineBreakMode="WordWrap"/>

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding TechnicalDetails}"
                                        FontSize="12"
                                        TextColor="Gray"
                                        LineBreakMode="WordWrap"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="1"
                    BackgroundColor="{AppThemeBinding Light=#B0B0B0, Dark=#606060}"/>

                <Button
                    Grid.Row="4"
                    Text="{x:Static res:AppResources.Dialog_Ok}"
                    HorizontalOptions="End"
                    Clicked="CloseClicked"/>

            </Grid>
        </Border>
    </Grid>
</ContentPage>